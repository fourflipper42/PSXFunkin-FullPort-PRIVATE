+static boolean Stage_ApplyModernPlayerKind(const Note *note)
+{
+	if (note->type & NOTE_FLAG_SUSTAIN)
+		return false;
+	if (stage.stage_id == StageId_8_3)
+	{
+		switch (note->pad)
+		{
+			case MODK_COCKGUN: stage.player->set_anim(stage.player, PicoPlayer_GunReload); return true;
+			case MODK_FIREGUN: stage.player->set_anim(stage.player, PicoPlayer_Shoot); return true;
+			default: break;
+		}
+	}
+	if (stage.stage_id == StageId_8_4)
+	{
+		switch (note->pad)
+		{
+			case MODK_BLOCKHIGH: case MODK_BLOCKLOW: stage.player->set_anim(stage.player, PicoBlazin_Block); return true;
+			case MODK_BLOCKSPIN: stage.player->set_anim(stage.player, PicoBlazin_Hit_Spin); return true;
+			case MODK_DODGELOW: case MODK_DODGEHIGH: stage.player->set_anim(stage.player, PicoBlazin_Dodge); return true;
+			case MODK_PUNCHHIGH: case MODK_PUNCHHIGHBLOCKED: stage.player->set_anim(stage.player, PicoBlazin_Punch_High_1); return true;
+			case MODK_PUNCHHIGHSPIN: stage.player->set_anim(stage.player, PicoBlazin_Punch_High_2); return true;
+			case MODK_PUNCHLOW: case MODK_PUNCHLOWDODGED: case MODK_PUNCHLOWBLOCKED: stage.player->set_anim(stage.player, PicoBlazin_Punch_Low_1); return true;
+			case MODK_PUNCHLOWSPIN: stage.player->set_anim(stage.player, PicoBlazin_Punch_Low_2); return true;
+			case MODK_HITHIGH: stage.player->set_anim(stage.player, PicoBlazin_Hit_High); return true;
+			case MODK_HITLOW: stage.player->set_anim(stage.player, PicoBlazin_Hit_Low); return true;
+			case MODK_PICO_UPPER_PREP: stage.player->set_anim(stage.player, PicoBlazin_Uppercut_Prep); return true;
+			case MODK_PICO_UPPER: stage.player->set_anim(stage.player, PicoBlazin_Uppercut_Punch); return true;
+			case MODK_FAKEOUT: stage.player->set_anim(stage.player, PicoBlazin_Fake_Hit); return true;
+			case MODK_TAUNT: stage.player->set_anim(stage.player, PicoBlazin_Taunt); return true;
+			default: break;
+		}
+	}
+	return false;
+}
+
+static boolean Stage_ApplyModernOpponentKind(const Note *note)
+{
+	if (note->type & NOTE_FLAG_SUSTAIN)
+		return false;
+	if (stage.stage_id == StageId_8_3)
+	{
+		switch (note->pad)
+		{
+			case MODK_LIGHTCAN: stage.opponent->set_anim(stage.opponent, Darnell_LightCan); return true;
+			case MODK_KICKCAN: stage.opponent->set_anim(stage.opponent, Darnell_KickUp); return true;
+			case MODK_KNEECAN: stage.opponent->set_anim(stage.opponent, Darnell_KneeForward); return true;
+			default: break;
+		}
+	}
+	if (stage.stage_id == StageId_8_4)
+	{
+		switch (note->pad)
+		{
+			case MODK_DARNELL_UPPER_PREP: stage.opponent->set_anim(stage.opponent, DarnellBlazin_Uppercut_Prep); return true;
+			case MODK_DARNELL_UPPER: stage.opponent->set_anim(stage.opponent, DarnellBlazin_Uppercut_Punch); return true;
+			case MODK_HITHIGH: stage.opponent->set_anim(stage.opponent, DarnellBlazin_Hit_High); return true;
+			case MODK_HITLOW: stage.opponent->set_anim(stage.opponent, DarnellBlazin_Hit_Low); return true;
+			case MODK_IDLE: stage.opponent->set_anim(stage.opponent, CharAnim_Idle); return true;
+			default: break;
+		}
+	}
+	return false;
+}

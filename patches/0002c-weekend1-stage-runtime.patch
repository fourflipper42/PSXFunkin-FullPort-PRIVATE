+// Weekend 1 story cinematics. Keep the last played ID so retrying a song does not replay its intro.
+static StageId weekend1_last_cutscene = StageId_Max;
+static void Stage_PlayWeekend1Cutscene(StageId id, boolean story)
+{
+	if (!story || id == weekend1_last_cutscene)
+		return;
+	Audio_StopXA();
+	switch (id)
+	{
+		case StageId_8_1: Movie_Play("\\MOVIE\\DARNELL.STR;1", 1297); break;
+		case StageId_8_3: Movie_Play("\\MOVIE\\2HOT.STR;1", 428); break;
+		case StageId_8_4: Movie_Play("\\MOVIE\\BLAZIN.STR;1", 657); break;
+		default: return;
+	}
+	weekend1_last_cutscene = id;
+}

+++ b/src/movie.c
@@ -8,14 +8,22 @@
 //Movie interface
 void Movie_Play(const char *path, unsigned long length)
 {
+	CdlFILE file;
+	if (CdSearchFile(&file, path) == 0)
+	{
+		sprintf(error_msg, "[Movie_Play] Missing \"%s\"", path);
+		ErrorLock();
+		return;
+	}
+	// Release the menu's Start press before allowing a cutscene skip.
+	while (PadRead(1) & PADstart)
+		VSync(0);
+
 	STRFILE sfile;
 	strcpy(sfile.FileName, path);
 	sfile.Xres = 320;
 	sfile.Yres = 240;
 	sfile.NumFrames = length;
-	if (PlayStr(320, 240, 0, 0, &sfile) == 0)
-	{
-		sprintf(error_msg, "[Movie_Play] Failed to play \"%s\"", path);
-		ErrorLock();
-	}
-}
\ No newline at end of file
+	// Zero also means a normal Start-button skip.
+	PlayStr(320, 240, 0, 0, &sfile);
+}

+//Difficulty availability
+
+boolean Stage_SupportsDifficulty(StageId id, StageDiff difficulty)
+{
+	if (difficulty <= StageDiff_Hard)
+		return true;
+
+	switch (id)
+	{
+		case StageId_1_1: // Bopeebo
+		case StageId_1_2: // Fresh
+		case StageId_1_3: // Dadbattle
+		case StageId_2_1: // Spookeez
+		case StageId_2_2: // South
+		case StageId_3_1: // Pico
+		case StageId_3_2: // Philly Nice
+		case StageId_3_3: // Blammed
+		case StageId_4_1: // Satin Panties
+		case StageId_4_2: // High
+		case StageId_5_1: // Cocoa
+		case StageId_5_2: // Eggnog
+		case StageId_6_1: // Senpai
+		case StageId_6_2: // Roses
+		case StageId_6_3: // Thorns
+		case StageId_7_1: // Ugh
+			return true;
+		default:
+			return false;
+	}
+}
